{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account and role information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "staff"] },
        "phoneNumber": { "type": "string" },
        "adminPhoneContact": { "type": "string" },
        "inviteCode": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "active"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Invite": {
      "title": "Invite Code",
      "description": "Codes generated by admin to invite staff",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "createdBy": { "type": "string" },
        "usedBy": { "type": "string" },
        "status": { "type": "string", "enum": ["available", "used"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "createdBy", "status"]
    },
    "WarehouseItem": {
      "title": "Warehouse Item",
      "description": "Inventory item details",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "category": { "type": "string" },
        "categoryIcon": { "type": "string" },
        "sku": { "type": "string" },
        "color": { "type": "string" },
        "specifications": { "type": "string" },
        "price": { "type": "number" },
        "currency": { "type": "string", "enum": ["IQD", "USD"] },
        "quantity": { "type": "number" },
        "isBroken": { "type": "boolean" },
        "lowStockThreshold": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "quantity"]
    },
    "InventoryLog": {
      "title": "Inventory Log",
      "description": "Transaction logs for stock changes",
      "type": "object",
      "properties": {
        "itemId": { "type": "string" },
        "itemName": { "type": "string" },
        "actionType": { "type": "string", "enum": ["create", "update", "delete", "stock_check"] },
        "changeDetails": { "type": "string" },
        "userId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["itemName", "actionType", "timestamp"]
    },
    "BrokenRecord": {
      "title": "Broken Record",
      "description": "Records of items that were broken and removed from stock",
      "type": "object",
      "properties": {
        "itemId": { "type": "string" },
        "itemName": { "type": "string" },
        "quantity": { "type": "number" },
        "reason": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "status": { "type": "string", "enum": ["broken", "fixed", "returned"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["itemId", "itemName", "quantity", "userId", "status", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user profiles and roles"
    },
    "/invites/{code}": {
      "schema": "Invite",
      "description": "Collection of invite codes for staff"
    },
    "/items/{itemId}": {
      "schema": "WarehouseItem",
      "description": "Central inventory collection"
    },
    "/logs/{logId}": {
      "schema": "InventoryLog",
      "description": "Global activity logs"
    },
    "/broken_records/{recordId}": {
      "schema": "BrokenRecord",
      "description": "Records of broken inventory"
    }
  }
}
